# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Prettier owns Markdown indentation; ordered-list continuations are 3 spaces.
[*.md]
indent_size = unset
trim_trailing_whitespace = false

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[LICENSE*]
indent_style = unset
indent_size = unset
